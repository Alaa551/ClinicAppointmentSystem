@model ClinicAppointmentSystem.PL.Models.AppointmentFormViewModel
@{
    ViewData["Title"] = "Appointments";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-muted mb-0">All booked appointments</p>
    <button type="button" class="btn btn-clinic-primary" onclick="openBookingModal()">
        <i class="ti ti-plus me-1"></i> New appointment
    </button>
</div>

<div class="clinic-card">
    <div class="table-responsive">
        <table id="appointmentsTable" class="table table-hover align-middle w-100">
            <thead>
                <tr>
                    <th>Doctor</th>
                    <th>Patient</th>
                    <th>Date</th>
                    <th>Time</th>
                    <th>Status</th>
                    <th class="no-sort text-end">Actions</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<!-- Booking modal -->
<div class="modal fade" id="appointmentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">New appointment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="appointmentForm">
                    <div class="mb-3">
                        <label asp-for="DoctorID" class="form-label"></label>
                        <div class="d-flex gap-2">
                            <select asp-for="DoctorID" id="DoctorAuto" class="form-control flex-grow-1" style="width:100%"></select>
                            <button type="button" class="btn btn-outline-secondary" onclick="openAddDoctorModal()" title="Add new doctor">
                                <i class="ti ti-plus"></i>
                            </button>
                        </div>
                        <span asp-validation-for="DoctorID" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PatientID" class="form-label"></label>
                        <div class="d-flex gap-2">
                            <select asp-for="PatientID" id="PatientAuto" class="form-control flex-grow-1" style="width:100%"></select>
                            <button type="button" class="btn btn-outline-secondary" onclick="openAddPatientModal()" title="Add new patient">
                                <i class="ti ti-plus"></i>
                            </button>
                        </div>
                        <span asp-validation-for="PatientID" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="AppointmentDate" class="form-label"></label>
                            <input asp-for="AppointmentDate" class="form-control" id="AppointmentDate" placeholder="dd-mm-yyyy" autocomplete="off" />
                            <span asp-validation-for="AppointmentDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="StartTime" class="form-label"></label>
                            <select asp-for="StartTime" id="StartTime" class="form-select">
                                <option value="">Select doctor and date first</option>
                            </select>
                            <span asp-validation-for="StartTime" class="text-danger small"></span>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-clinic-primary" onclick="bookAppointment()">Book appointment</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/appointments.js"></script>
}
