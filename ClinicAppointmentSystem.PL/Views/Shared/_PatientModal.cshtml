@model ClinicAppointmentSystem.PL.Models.PatientFormViewModel
@using ClinicAppointmentSystem.DAL.Enums

<div class="modal fade" id="patientModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="patientModalTitle">Add patient</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="patientForm">
                    <input type="hidden" asp-for="PatientID" />
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" id="PName" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="BirthDate" class="form-label"></label>
                        <input asp-for="BirthDate" class="form-control" id="PBirthDate" placeholder="dd-mm-yyyy" autocomplete="off" />
                        <span asp-validation-for="BirthDate" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Gender" class="form-label"></label>
                        <select asp-for="Gender" class="form-select" id="PGender">
                            <option value="">Select</option>
                            @foreach (var g in Enum.GetValues<Gender>())
                            {
                                <option value="@g.ToString()">@g.ToString()</option>
                            }
                        </select>
                        <span asp-validation-for="Gender" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="PhoneNumber" class="form-label"></label>
                        <input asp-for="PhoneNumber" class="form-control" id="PPhoneNumber" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Street" class="form-label"></label>
                        <input asp-for="Street" class="form-control" id="PStreet" />
                        <span asp-validation-for="Street" class="text-danger small"></span>
                    </div>
                    <div class="row">
                        <div class="col-8">
                            <div class="mb-3">
                                <label asp-for="City" class="form-label"></label>
                                <input asp-for="City" class="form-control" id="PCity" />
                                <span asp-validation-for="City" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="mb-3">
                                <label asp-for="ZipCode" class="form-label"></label>
                                <input asp-for="ZipCode" class="form-control" id="PZipCode" />
                                <span asp-validation-for="ZipCode" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-cancel waves-effect" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary waves-effect waves-light" onclick="savePatient()">Save</button>
            </div>
        </div>
    </div>
</div>