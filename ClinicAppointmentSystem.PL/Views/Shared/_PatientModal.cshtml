<div class="modal fade" id="patientModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="patientModalTitle">Add patient</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="patientForm">
                    <input type="hidden" id="PatientID" value="0" />
                    <div class="mb-3">
                        <label class="form-label">Full name</label>
                        <input type="text" id="PName" name="Name" class="form-control" />
                        <span class="text-danger small" data-valmsg-for="Name"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Birth date</label>
                        <input type="text" id="PBirthDate" name="BirthDate" class="form-control" placeholder="dd-mm-yyyy" />
                        <span class="text-danger small" data-valmsg-for="BirthDate"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Gender</label>
                        <select id="PGender" name="Gender" class="form-select">
                            <option value="">Select</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                        </select>
                        <span class="text-danger small" data-valmsg-for="Gender"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Phone number</label>
                        <input type="text" id="PPhoneNumber" name="PhoneNumber" class="form-control" />
                        <span class="text-danger small" data-valmsg-for="PhoneNumber"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Address</label>
                        <input type="text" id="PAddress" name="Address" class="form-control" />
                        <span class="text-danger small" data-valmsg-for="Address"></span>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="savePatient()">Save</button>
            </div>
        </div>
    </div>
</div>
