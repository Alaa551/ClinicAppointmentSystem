@{
    ViewData["Title"] = "Doctor details";
    var doctorId = (int)ViewData["DoctorID"];
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <a asp-action="Index" class="btn btn-cancel waves-effect">
        <i data-feather="arrow-left" class="me-1"></i> Back to doctors
    </a>
</div>

<!-- Doctor profile header -->
<div class="card table-list-card shadow-sm border-0 mb-3">
    <div class="card-body d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-3">
            <div id="doctorAvatar" class="clinic-avatar">--</div>
            <div>
                <p class="mb-0 fw-medium fs-5" id="doctorNameDisplay">Loading...</p>
                <p class="mb-0 text-muted small" id="doctorMetaDisplay"></p>
            </div>
        </div>
        <span id="doctorStatusDisplay"></span>
    </div>
</div>

<!-- Weekly schedule -->
<div class="card table-list-card shadow-sm border-0">
    <div class="card-body">
        <div class="table-top">
            <p class="mb-0 fw-medium">Weekly schedule</p>
        </div>
        <div class="schedule-week-grid" id="scheduleWeekGrid"></div>
    </div>
</div>

@section Scripts {
    <script>
        window.currentDoctorId = @doctorId;
    </script>
    <script src="~/js/doctor-details.js"></script>
}
