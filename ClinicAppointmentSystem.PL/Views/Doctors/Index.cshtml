@{
    ViewData["Title"] = "Doctors";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-muted mb-0">Manage the clinic's doctors</p>
    <button type="button" class="btn btn-clinic-primary" onclick="openAddDoctorModal()">
        <i class="ti ti-plus me-1"></i> Add doctor
    </button>
</div>

<div class="clinic-card">
    <table id="doctorsTable" class="table table-hover align-middle w-100">
        <thead>
            <tr>
                <th>Name</th>
                <th>Specialization</th>
                <th>Phone</th>
                <th>Email</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>
