@{
    ViewData["Title"] = "Patients";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-muted mb-0">Manage patient records</p>
    <button type="button" class="btn btn-clinic-primary" onclick="openAddPatientModal()">
        <i class="ti ti-plus me-1"></i> Add patient
    </button>
</div>

<div class="clinic-card">
    <div class="table-responsive">
        <table id="patientsTable" class="table table-hover align-middle w-100">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Birth date</th>
                    <th>Gender</th>
                    <th>Phone</th>
                    <th>Address</th>
                    <th class="no-sort text-end">Actions</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>
